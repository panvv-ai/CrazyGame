# Required for the first Docker start. Change these before exposing the service.
AUTH_USERNAME=owner
AUTH_PASSWORD=change-this-password

# Generate a long random value, for example:
# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

DATA_DIR=./data
TZ=Asia/Shanghai

# Optional AI defaults. You can also configure these in the web UI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional network proxy for outbound quote requests.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
