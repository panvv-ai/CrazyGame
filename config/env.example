# Optional. When omitted, a local key is generated under DATA_DIR.
# Generate a long random value with:
# openssl rand -hex 32
APP_SECRET_KEY=

DATA_DIR=./data
TZ=Asia/Shanghai

# Optional AI defaults. You can also configure these in the web UI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

