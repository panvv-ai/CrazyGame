# Optional. When omitted, a local key is generated under DATA_DIR.
# Generate a long random value with:
# openssl rand -hex 32
APP_SECRET_KEY=

DATA_DIR=./data
TZ=Asia/Shanghai
CRAZYGAME_TAG=latest

# Optional AI defaults. You can also configure these in the web UI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional vision-capable model. Empty inherits AI_MODEL.
AI_VISION_MODEL=

# Free public news and announcements are enabled by default.
# Enhanced search providers are optional and use a user-owned key.
NEWS_ENABLED=true
NEWS_PROVIDER=eastmoney
NEWS_API_KEY=

# Optional network proxy for outbound quote requests.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
